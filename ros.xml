  <project name="meta-virtualization.git" path="dey5.0/sources/meta-virtualization" remote="yocto" revision="scarthgap"/>
  <project name="meta-webkit.git" path="dey5.0/sources/meta-webkit" remote="igl" revision="scarthgap"/>
  <project name="meta-wolfssl.git" path="dey5.0/sources/meta-wolfssl" remote="wlf" revision="master"/>
  <project name="poky.git" path="dey5.0/sources/poky" remote="yocto" revision="scarthgap"/>

  <project name="dey-aio.git" path="aio/scarthgap" remote="peyoot" revision="scarthgap-ros">
