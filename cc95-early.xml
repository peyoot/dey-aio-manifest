  <project name="meta-wolfssl.git" path="dey5.0/sources/meta-wolfssl" remote="wlf" revision="master"/>
  <project name="poky.git" path="dey5.0/sources/poky" remote="yocto" revision="scarthgap"/>

  <project name="dey-aio.git" path="aio/scarthgap" remote="peyoot" revision="scarthgap">
    <linkfile src="mkproject.sh" dest="dey5.0/mkproject.sh"/>
    <linkfile src="docker-compose.yml" dest="dey5.0/docker-compose.yml"/>
    <copyfile src="workspace/.gitignore" dest="dey5.0/workspace/.gitignore"/>
